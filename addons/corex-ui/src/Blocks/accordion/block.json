{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "corex/accordion",
	"title": "Corex Accordion",
	"category": "corex",
	"icon": "menu",
	"description": "Questions that open to show their answers, each answer holding any blocks. Works without JavaScript.",
	"textdomain": "corex",
	"attributes": {
		"items": { "type": "array", "default": [], "items": { "type": "object" } },
		"oneOpen": { "type": "boolean", "default": false },
		"headingLevel": { "type": "integer", "default": 0, "enum": [ 0, 2, 3, 4, 5, 6 ] }
	},
	"providesContext": { "corex/accordionHeadingLevel": "headingLevel" },
	"allowedBlocks": [ "corex/accordion-item" ],
	"supports": {
		"html": false,
		"anchor": true,
		"align": ["wide", "full"],
		"spacing": { "margin": ["top", "bottom"], "padding": ["vertical", "horizontal"] },
		"color": { "background": true, "text": true }
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"corex": { "renderer": "Corex\\Ui\\Blocks\\AccordionRenderer", "editor": "in-place" }
}
