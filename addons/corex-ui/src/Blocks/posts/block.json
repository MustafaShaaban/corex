{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "corex/posts",
	"title": "Corex Posts",
	"category": "corex",
	"icon": "list-view",
	"description": "A list of recent posts as accessible cards (dynamic, bounded).",
	"textdomain": "corex",
	"attributes": {
		"count": { "type": "number", "default": 3 }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": ["wide", "full"],
		"spacing": { "margin": ["top", "bottom"], "padding": ["vertical", "horizontal"] },
		"color": { "background": true, "text": true }
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"corex": { "renderer": "Corex\\Ui\\Blocks\\PostsRenderer", "editor": "records" }
}
