{
    "name": "corex-framework",
    "version": "0.43.5",
    "private": true,
    "description": "Corex — WordPress framework monorepo (npm workspaces root).",
    "license": "GPL-2.0-or-later",
    "engines": {
        "node": ">=22.22.2"
    },
    "workspaces": [
        "packages/build-tools",
        "plugins/corex-blocks",
        "plugins/corex-forms",
        "addons/corex-ui",
        "addons/corex-careers",
        "addons/corex-kit-portfolio",
        "plugins/corex-config"
    ],
    "scripts": {
        "build": "npm run build --workspaces --if-present",
        "start": "npm run start --workspaces --if-present",
        "lint:js": "wp-scripts lint-js",
        "lint:css": "wp-scripts lint-style",
        "test:js": "wp-scripts test-unit-jest",
        "test:e2e": "playwright test --config=tests/e2e/playwright.config.js",
        "verify:dependencies": "node scripts/verify-dependency-security.mjs",
        "build:dist": "node scripts/build-shared-host-dist.mjs",
        "verify:dist": "node scripts/verify-shared-host-dist.mjs",
        "verify:framework": "node scripts/verify-framework.mjs",
        "format": "wp-scripts format",
        "env:start": "wp-env start",
        "env:stop": "wp-env stop"
    },
    "devDependencies": {
        "@babel/core": "^7.25.7",
        "@playwright/test": "^1.63.0",
        "@wordpress/babel-preset-default": "8.55.0",
        "@wordpress/env": "^11.12.0",
        "@wordpress/eslint-plugin": "^27.1.0",
        "@wordpress/jest-preset-default": "14.2.0",
        "@wordpress/scripts": "^36.1.0",
        "babel-jest": "^30.5.0",
        "eslint-plugin-jest": "^29.0.0",
        "jest": "^30.5.0",
        "jest-environment-jsdom": "^30.5.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "overrides": {
        "brace-expansion": "^5.0.12",
        "fast-uri": "^3.1.8",
        "qs": "^6.16.0",
        "serialize-javascript": "^7.0.7",
        "uuid": "^14.0.1",
        "webpack-dev-server": "^6.0.0",
        "@opentelemetry/core": "^2.10.0",
        "markdown-it": "^14.3.2",
        "linkify-it": "^6.1.0",
        "adm-zip": "^0.6.1",
        "basic-ftp": "^6.2.2",
        "markdownlint-cli": {
            "js-yaml": "^5.4.3",
            "smol-toml": "^1.9.0"
        },
        "katex": "^0.18.2",
        "postcss-selector-parser": "^7.1.6"
    }
}
