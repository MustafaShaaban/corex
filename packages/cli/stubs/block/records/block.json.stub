{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "{{ block_name }}",
	"title": "{{ title }}",
	"category": "corex",
	"icon": "block-default",
	"description": "{{ title }}: a CoreX block that shows records, previewed by the server.",
	"textdomain": "{{ text_domain }}",
	"attributes": {},
	"supports": { "html": false, "anchor": true },
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"corex": { "renderer": "{{ renderer_fqcn }}", "editor": "records" }
}
