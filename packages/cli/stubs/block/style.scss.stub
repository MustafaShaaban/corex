/**
 * {{ title }}: every value a theme.json token, every property logical
 * (right to left by default). Imported by index.js, compiled by
 * @wordpress/scripts to style-index.css, loaded only where the block is.
 */
.{{ css_class }} {
	padding-block: var(--wp--preset--spacing--40);
	color: var(--wp--preset--color--ink);
}

.{{ css_class }}__title {
	margin-block: var(--wp--preset--spacing--10);
	font-size: var(--wp--preset--font-size--lg);
}
