<?php

/**
 * @package {{ namespace }}
 */

declare(strict_types=1);

namespace {{ namespace }};

defined('ABSPATH') || exit;

use Corex\Blocks\BlockWrapper;
use Corex\Boot;
use Corex\Container\ContainerInterface;
use {{ namespace }}\Blocks\ExampleRenderer;
use {{ namespace }}\Controllers\ExampleController;
use {{ namespace }}\Options\ExampleOptions;
use {{ namespace }}\Repositories\ExampleRepository;
use {{ namespace }}\Services\ExampleService;

/**
 * The {{ name }} site service provider — the composition root where your site's pieces are
 * wired. With --starter it registers a runnable example (REST route + block + options page);
 * remove that wiring per REMOVE-EXAMPLE.md and add your own. App code lives under
 * {{ namespace }}\. REST namespace: {{ rest_namespace }}. Option/CPT prefix: {{ option_prefix }}.
 */
final class {{ namespace }}ServiceProvider
{
    private ExampleService $exampleService;

    /**
     * @param ContainerInterface|null $container CoreX's container; left out, it is CoreX's own
     *                                           once Corex has booted (a test passes its own).
     */
    public function __construct(private readonly ?ContainerInterface $container = null)
    {
    }

    public function register(): void
    {
        // Composition root: build the example's object graph once. (--starter example.)
        $this->exampleService = new ExampleService(new ExampleRepository());
    }

    public function boot(): void
    {
        // --starter example wiring — delete this block when you remove the example.
        (new ExampleController($this->exampleService))->register();
        (new ExampleOptions())->register();

        add_action('init', function (): void {
            $renderer = new ExampleRenderer($this->exampleService);
            // What an editor sets on the block (its anchor, an extra class) reaches its root
            // element through CoreX's BlockWrapper, as on every CoreX block (spec 136, FR-001).
            // Corex boots on plugins_loaded, so its container is ready by init.
            $container = $this->container ?? (Boot::booted() ? Boot::app()->container() : null);
            $wrapper = $container !== null && $container->has(BlockWrapper::class)
                ? $container->make(BlockWrapper::class)
                : null;
            register_block_type(__DIR__ . '/Blocks/example', [
                'render_callback' => static fn (): string => $wrapper === null
                    ? $renderer->render()
                    : $wrapper->apply($renderer->render()),
            ]);
        });
    }
}
