<?xml version="1.0" encoding="UTF-8"?>
<!--
  Headless test configuration for {{ name }} (part of the starter scaffold).

  Run from this directory with the framework's Pest:   ../../../vendor/bin/pest
  The paths below assume the site sits at <repository>/sites/<client>/{{ plugin_slug }}.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../../../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="{{ namespace }}">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
