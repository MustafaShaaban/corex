<?php

/**
 * @package {{ namespace }}
 */

declare(strict_types=1);

namespace {{ namespace }}\Blocks;

defined('ABSPATH') || exit;

use Corex\Blocks\BlockRenderer;
use {{ namespace }}\Services\ExampleService;

/**
 * Server-renders the {{ plugin_slug }}/example block: escaped, i18n-ready, token-styled,
 * RTL-correct. CoreX resolves it from the container (its block.json names it in
 * `corex.renderer`), so the service arrives by constructor injection. Part of the --starter
 * example; delete it per REMOVE-EXAMPLE.md.
 */
final class ExampleRenderer implements BlockRenderer
{
    public function __construct(private readonly ExampleService $service)
    {
    }

    /**
     * @param array<string, mixed> $attributes
     */
    public function render(array $attributes, string $content, object $block): string
    {
        $items = $this->service->all();

        if ($items === []) {
            return '<p class="{{ theme_slug }}-example">'
                . esc_html__('No examples yet.', '{{ text_domain }}')
                . '</p>';
        }

        $list = '';
        foreach ($items as $item) {
            $list .= '<li>' . esc_html($item->title) . '</li>';
        }

        return '<ul class="{{ theme_slug }}-example">' . $list . '</ul>';
    }
}
