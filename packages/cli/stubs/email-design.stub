<?php

/**
 * @package {{ namespace }}
 */

declare(strict_types=1);

namespace {{ namespace }};

defined('ABSPATH') || exit;

use Corex\Email\Design\EmailBrand;
use Corex\Email\Design\EmailContent;
use Corex\Email\Design\EmailDesign;

/**
 * {{ class }} — this site's own design for the emails CoreX sends for it.
 *
 * It starts as a copy of CoreX's standard design. Change anything in it: this file is yours and
 * a CoreX update does not touch it.
 *
 * Register it once, from this plugin's service provider `boot()`:
 *
 *     add_filter('corex_email_design', static fn () => new {{ class }}());
 *
 * What you are handed:
 *
 * - `$content->subject`    plain text. Escape it before you print it.
 * - `$content->bodyHtml`   the message, already cleaned: only `<p>`, `<br>`, `<strong>`, `<b>`,
 *                          `<em>`, `<i>`, `<ul>`, `<ol>`, `<li>` and `<a href>`. Print it as it
 *                          is. You may add attributes to its tags; you must not leave it out.
 * - `$content->recipient`  the address the email is for.
 * - `$brand`               the site's name, address, logo, direction (`ltr` or `rtl`), language,
 *                          footer line, and its light and dark colours.
 *
 * If this design throws, answers nothing, or answers a document without the message, CoreX
 * sends the email in its standard design and tells the site's email managers why.
 *
 * Mail clients lay out tables and inline styles, and little else: no style sheet for the
 * message, no custom properties, no flexbox. Keep widths fluid up to 600 pixels. The cells are
 * aligned `left` or `right` from the site's direction, because Outlook does not read `start`;
 * each paragraph carries `dir="auto"` and `text-align:start`, which every client that is a
 * browser reads, so a line in another language starts from its own side.
 */
final class {{ class }} implements EmailDesign
{
    public function render(EmailContent $content, EmailBrand $brand): string
    {
        $colours = $brand->light;
        $align = $brand->direction === 'rtl' ? 'right' : 'left';
        $font = EmailBrand::FONT;

        // The footer line the site set, or one naming the site. Translate the sentence with
        // your own text domain if the site is not in English.
        $footer = $brand->footer !== ''
            ? $this->escaped($brand->footer)
            : sprintf(
                'This message was sent by <a class="own-muted" style="color:%s;text-decoration:underline" href="%s">%s</a>.',
                $colours->muted,
                $this->webAddress($brand->homeUrl),
                $this->escaped($brand->name),
            );

        return '<!DOCTYPE html>'
            . sprintf('<html lang="%s" dir="%s">', $this->escaped($brand->language), $brand->direction)
            . '<head><meta charset="utf-8" />'
            . '<meta name="viewport" content="width=device-width, initial-scale=1" />'
            . '<meta name="color-scheme" content="light dark" />'
            . '<meta name="supported-color-schemes" content="light dark" />'
            . '<title>' . $this->escaped($content->subject) . '</title>'
            . $this->darkScheme($brand)
            . '</head>'
            . sprintf('<body class="own-canvas" style="margin:0;padding:0;background:%s">', $colours->canvas)
            . sprintf(
                '<table role="presentation" class="own-canvas" width="100%%" cellpadding="0" cellspacing="0" style="background:%s">'
                . '<tr><td align="center" style="padding:24px 12px">',
                $colours->canvas,
            )
            . '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px">'
            // The header is the first band of the card, and the message the second: one box
            // with the brand's edge along its top.
            // Each side of each band is written singly: Outlook's engine reads a border taken
            // back (`border-top:0`) less surely than one never given.
            . sprintf(
                '<tr><td class="own-surface own-band own-text" style="padding:16px 24px;background:%1$s;border-top:4px solid %3$s;border-left:1px solid %2$s;border-right:1px solid %2$s;border-bottom:1px solid %2$s;border-radius:10px 10px 0 0;text-align:%4$s;%5$s">%6$s</td></tr>',
                $colours->surface,
                $colours->border,
                $colours->accent,
                $align,
                $this->headerType($brand),
                $this->header($brand, $align),
            )
            . sprintf(
                '<tr><td class="own-surface" style="padding:24px 24px 8px;background:%1$s;border-left:1px solid %2$s;border-right:1px solid %2$s;border-bottom:1px solid %2$s;border-radius:0 0 10px 10px;text-align:%3$s">%4$s</td></tr>',
                $colours->surface,
                $colours->border,
                $align,
                $this->message($content->bodyHtml, $brand),
            )
            . sprintf(
                '<tr><td class="own-muted" style="padding:16px 0 0;text-align:%s;color:%s;font-family:%s;font-size:12px;line-height:1.6">%s</td></tr>',
                $align,
                $colours->muted,
                $font,
                $footer,
            )
            . '</table></td></tr></table></body></html>';
    }

    /**
     * The message, with a style written on each of its elements: a mail client reads no style
     * sheet for them. `dir="auto"` lets each paragraph take the direction of its own language.
     */
    private function message(string $bodyHtml, EmailBrand $brand): string
    {
        $text = sprintf('color:%s;font-family:%s;font-size:16px;line-height:1.6', $brand->light->text, EmailBrand::FONT);

        return strtr($bodyHtml, [
            '<p>' => sprintf('<p dir="auto" class="own-text" style="margin:0 0 16px;text-align:start;%s">', $text),
            '<ul>' => '<ul style="margin:0 0 16px;padding:0 24px">',
            '<ol>' => '<ol style="margin:0 0 16px;padding:0 24px">',
            '<li>' => sprintf('<li dir="auto" class="own-text" style="margin:0 0 6px;text-align:start;%s">', $text),
            '<a href=' => sprintf('<a class="own-link" style="color:%s;text-decoration:underline" href=', $brand->light->link),
        ]);
    }

    /** The header's type, written on every cell that holds its words. */
    private function headerType(EmailBrand $brand): string
    {
        return sprintf('color:%s;font-family:%s;font-size:18px;font-weight:600;line-height:1.3', $brand->light->text, EmailBrand::FONT);
    }

    /**
     * What the card opens with: the site's name, its logo, or its mark and its name.
     *
     * A logo is held to a box of 180 by 48. `logoBox()` is the size that fits, where the
     * logo's real size is known: written as the image's own `width` and `height`, which is
     * all Outlook on Windows reads, and as a width in its style with the height left to
     * follow, so that a client showing no images draws the name across that width in as many
     * lines as it needs.
     *
     * A logo that is the name written out (`logoIsItsName()`: at least twice as wide as
     * tall) stands alone with the name as its `alt`. A mark has the name beside it as text:
     * a mail client that blocks images would otherwise show an email from nobody.
     *
     * A logo whose size is not known is limited by its style alone.
     */
    private function header(EmailBrand $brand, string $align): string
    {
        $name = $this->escaped($brand->name);
        $logo = $this->webAddress($brand->logo);
        if ($logo === '') {
            return $name;
        }
        $box = $brand->logoBox();
        if ($box === null) {
            return sprintf(
                '<img src="%s" alt="%s" style="display:inline-block;vertical-align:middle;width:auto;height:auto;max-width:%dpx;max-height:%dpx;border:0" />',
                $logo,
                $name,
                EmailBrand::LOGO_WIDTH,
                EmailBrand::LOGO_HEIGHT,
            );
        }
        $image = sprintf(
            '<img src="%s" alt="%s" width="%d" height="%d" style="display:inline-block;vertical-align:middle;width:%dpx;max-width:100%%;height:auto;border:0" />',
            $logo,
            $brand->logoIsItsName() ? $name : '',
            $box[0],
            $box[1],
            $box[0],
        );
        if ($brand->logoIsItsName()) {
            return $image;
        }

        // Two cells, because a mail client gives an image no margin: the space between the
        // mark and the name is the first cell's padding, on the side the name is on.
        return sprintf(
            '<table role="presentation" dir="%1$s" align="%2$s" cellpadding="0" cellspacing="0"><tr>'
            . '<td style="padding-%3$s:12px;vertical-align:middle">%4$s</td>'
            . '<td class="own-text" style="vertical-align:middle;text-align:%2$s;%5$s">%6$s</td>'
            . '</tr></table>',
            $brand->direction,
            $align,
            $align === 'left' ? 'right' : 'left',
            $image,
            $this->headerType($brand),
            $name,
        );
    }

    /**
     * The dark colours, for a mail client that asks for them. The light ones are written on
     * each element, for the client that honours nothing else.
     */
    private function darkScheme(EmailBrand $brand): string
    {
        $dark = $brand->dark;

        return '<style>:root{color-scheme:light dark}'
            . '@media (prefers-color-scheme: dark){'
            . sprintf('.own-canvas{background:%s !important}', $dark->canvas)
            . sprintf('.own-surface{background:%s !important;border-color:%s !important}', $dark->surface, $dark->border)
            . sprintf('.own-band{border-top-color:%s !important}', $dark->accent)
            . sprintf('.own-text{color:%s !important}', $dark->text)
            . sprintf('.own-muted{color:%s !important}', $dark->muted)
            . sprintf('.own-link{color:%s !important}', $dark->link)
            . '}</style>';
    }

    /**
     * A whole web address, escaped for an attribute, or '' for anything else: a mail client has
     * no page to resolve a path from.
     */
    private function webAddress(string $value): string
    {
        return preg_match('#^https?://#i', $value) === 1 ? $this->escaped($value) : '';
    }

    private function escaped(string $value): string
    {
        return htmlspecialchars($value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
    }
}
