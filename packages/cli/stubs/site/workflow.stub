# {{ name }} — the client site's own checks.
#
# Generated by `wp corex make:site`. This file is the client's: the framework never ships a
# workflow named `site-*.yml`, so a framework update cannot conflict with it. Change it freely.
#
# It contains no GitHub expression on purpose. Conditions are written as shell tests so the file
# can be produced by the same stub renderer as every other generated file.
name: Site ({{ name }})

on:
  push:
    branches: [main, develop]
  pull_request:

permissions:
  contents: read

jobs:
  framework-unmodified:
    name: Framework files are unmodified
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
        with:
          # The baseline commit has to be present, and a shallow clone does not contain it.
          fetch-depth: 0

      - uses: actions/setup-node@v7
        with:
          node-version: '22'

      # Git and Node only — nothing is installed for this.
      - name: Compare framework-owned paths with the recorded baseline
        run: node scripts/verify-framework.mjs

  client-build:
    name: Client build from a clean install
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7

      - uses: actions/setup-node@v7
        with:
          node-version: '22'

      # Deliberately no install at the repository root. A client package that imports something
      # it does not declare would otherwise resolve it from the framework's node_modules, and
      # break on the day a framework update removes it.
      - name: Install, build and test each client package
        run: |
          set -euo pipefail
          for dir in sites/{{ site_dir }}/{{ plugin_slug }} sites/{{ site_dir }}/{{ theme_slug }}; do
            if [ ! -f "$dir/package.json" ]; then
              echo "No package.json in $dir — nothing to build."
              continue
            fi
            echo "::group::$dir"
            if [ -f "$dir/package-lock.json" ]; then
              ( cd "$dir" && npm ci )
            else
              ( cd "$dir" && npm install )
            fi
            ( cd "$dir" && npm run build --if-present && npm run test:js --if-present )
            echo "::endgroup::"
          done

  client-tests:
    name: Client PHP tests
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7

      - uses: shivammathur/setup-php@v2
        with:
          php-version: '8.3'
          tools: composer:v2
          coverage: none

      # Pest and the framework classes the client's tests extend come from the root install.
      - name: Install Composer dependencies
        run: composer install --prefer-dist --no-progress

      - name: Run the client plugin's tests
        run: |
          set -euo pipefail
          plugin=sites/{{ site_dir }}/{{ plugin_slug }}
          if [ ! -f "$plugin/phpunit.xml.dist" ]; then
            echo "No phpunit.xml.dist in $plugin — nothing to run."
            exit 0
          fi
          cd "$plugin" && ../../../vendor/bin/pest
