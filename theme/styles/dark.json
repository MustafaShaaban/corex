{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "title": "Dark",
    "settings": {
        "color": {
            "palette": [
                { "slug": "primary", "color": "#f4f5f7", "name": "Primary" },
                { "slug": "primary-dark", "color": "#c2c8d1", "name": "Primary dark" },
                { "slug": "accent", "color": "#c9a25e", "name": "Accent" },
                { "slug": "accent-dark", "color": "#e2c188", "name": "Accent dark" },
                { "slug": "surface", "color": "#16181d", "name": "Surface" },
                { "slug": "surface-alt", "color": "#1a1d23", "name": "Surface alt" },
                { "slug": "border", "color": "#646b78", "name": "Border" },
                { "slug": "ink", "color": "#f4f5f7", "name": "Ink" },
                { "slug": "ink-soft", "color": "#9aa0ab", "name": "Ink soft" },
                { "slug": "success", "color": "#5fb787", "name": "Success" },
                { "slug": "warning", "color": "#e0a33a", "name": "Warning" },
                { "slug": "error", "color": "#e0645c", "name": "Error" },
                { "slug": "info", "color": "#6e9be6", "name": "Info" },
                { "slug": "inverse", "color": "#14151a", "name": "Inverse text" },
                { "slug": "overlay", "color": "rgba(7, 9, 12, 0.72)", "name": "Overlay" },
                { "slug": "selection", "color": "#c9a25e", "name": "Selection" },
                { "slug": "selection-text", "color": "#14151a", "name": "Selection text" },
                { "slug": "surface-raised", "color": "#1c1f26", "name": "Raised surface" },
                { "slug": "surface-strong", "color": "#262a32", "name": "Strong surface" },
                { "slug": "background", "color": "#16181d", "name": "Background (compatibility)" },
                { "slug": "foreground", "color": "#f4f5f7", "name": "Foreground (compatibility)" },
                { "slug": "danger", "color": "#e0645c", "name": "Danger (compatibility)" },
                { "slug": "corex-danger", "color": "#e0645c", "name": "CoreX danger (compatibility)" },
                { "slug": "corex-info", "color": "#6e9be6", "name": "CoreX info (compatibility)" },
                { "slug": "corex-primary", "color": "#f4f5f7", "name": "CoreX primary (compatibility)" },
                { "slug": "corex-success", "color": "#5fb787", "name": "CoreX success (compatibility)" },
                { "slug": "corex-warning", "color": "#e0a33a", "name": "CoreX warning (compatibility)" },
                { "slug": "white", "color": "#14151a", "name": "White (compatibility)" }
            ]
        },
        "shadow": {
            "presets": [
                { "slug": "sm", "name": "Small", "shadow": "0 1px 2px rgb(0 0 0 / 20%)" },
                { "slug": "md", "name": "Medium", "shadow": "0 8px 24px rgb(0 0 0 / 24%)" },
                { "slug": "lg", "name": "Large", "shadow": "0 18px 48px rgb(0 0 0 / 28%)" }
            ]
        },
        "custom": {
            "color": {
                "onAccent": "#14151a",
                "accentHover": "#e6cf9f",
                "accentSubtle": "rgba(201, 162, 94, 0.14)",
                "successSoft": "rgba(95, 183, 135, 0.13)",
                "warningSoft": "rgba(224, 163, 58, 0.13)",
                "errorSoft": "rgba(224, 100, 92, 0.13)",
                "infoSoft": "rgba(110, 155, 230, 0.13)",
                "band": "#0d0e11",
                "bandRaised": "#16181d",
                "bandInk": "#f4f5f7",
                "bandInkSoft": "#9aa0ab",
                "bandLine": "#262a32",
                "bandBorder": "#646b78",
                "bandAccent": "#c9a25e",
                "bandAccentHover": "#e6cf9f",
                "bandAccentSubtle": "rgba(201, 162, 94, 0.14)",
                "bandLink": "#e2c188"
            }
        },
        "typography": {
            "fontFamilies": [
                {
                    "slug": "heading",
                    "name": "Heading",
                    "fontFamily": "'Space Grotesk', system-ui, sans-serif",
                    "fontFace": [{ "fontFamily": "Space Grotesk", "fontStyle": "normal", "fontWeight": "500 700", "fontDisplay": "swap", "src": ["file:./assets/fonts/space-grotesk-latin-500-700.woff2"] }]
                },
                {
                    "slug": "arabic",
                    "name": "Arabic",
                    "fontFamily": "'IBM Plex Sans Arabic', system-ui, sans-serif",
                    "fontFace": [
                        { "fontFamily": "IBM Plex Sans Arabic", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "unicodeRange": "U+0600-06FF, U+0750-077F, U+0870-08FF, U+FB50-FDFF, U+FE70-FEFF", "src": ["file:./assets/fonts/ibm-plex-sans-arabic-400.woff2"] },
                        { "fontFamily": "IBM Plex Sans Arabic", "fontStyle": "normal", "fontWeight": "600", "fontDisplay": "swap", "unicodeRange": "U+0600-06FF, U+0750-077F, U+0870-08FF, U+FB50-FDFF, U+FE70-FEFF", "src": ["file:./assets/fonts/ibm-plex-sans-arabic-600.woff2"] }
                    ]
                },
                { "slug": "body", "name": "Body", "fontFamily": "system-ui, sans-serif" },
                {
                    "slug": "mono",
                    "name": "Technical",
                    "fontFamily": "'JetBrains Mono', ui-monospace, 'Cascadia Code', monospace",
                    "fontFace": [{ "fontFamily": "JetBrains Mono", "fontStyle": "normal", "fontWeight": "400 600", "fontDisplay": "swap", "src": ["file:./assets/fonts/jetbrains-mono-latin-400-600.woff2"] }]
                }
            ]
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--surface)",
            "text": "var(--wp--preset--color--ink)"
        }
    }
}
