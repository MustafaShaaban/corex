{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "layout": {
            "contentSize": "768px",
            "wideSize": "1200px"
        },
        "color": {
            "palette": [
                { "slug": "primary", "color": "#0B1F3B", "name": "Primary" },
                { "slug": "primary-dark", "color": "#06121F", "name": "Primary dark" },
                { "slug": "accent", "color": "#007A9E", "name": "Accent" },
                { "slug": "accent-dark", "color": "#006080", "name": "Accent dark" },
                { "slug": "surface", "color": "#FFFFFF", "name": "Surface" },
                { "slug": "surface-alt", "color": "#F4F7FA", "name": "Surface alt" },
                { "slug": "border", "color": "#8795A3", "name": "Border" },
                { "slug": "ink", "color": "#11181C", "name": "Ink" },
                { "slug": "ink-soft", "color": "#5A6772", "name": "Ink soft" },
                { "slug": "success", "color": "#1A7F4B", "name": "Success" },
                { "slug": "warning", "color": "#875400", "name": "Warning" },
                { "slug": "error", "color": "#C1352B", "name": "Error" },
                { "slug": "info", "color": "#1F6FEB", "name": "Info" },
                { "slug": "inverse", "color": "#FFFFFF", "name": "Inverse text" },
                { "slug": "overlay", "color": "rgba(6, 18, 31, 0.72)", "name": "Overlay" },
                { "slug": "selection", "color": "#BFEFFF", "name": "Selection" },
                { "slug": "selection-text", "color": "#06121F", "name": "Selection text" },
                { "slug": "surface-raised", "color": "#FFFFFF", "name": "Raised surface" },
                { "slug": "surface-strong", "color": "#E8EEF5", "name": "Strong surface" },
                { "slug": "background", "color": "#FFFFFF", "name": "Background (compatibility)" },
                { "slug": "foreground", "color": "#11181C", "name": "Foreground (compatibility)" },
                { "slug": "danger", "color": "#C1352B", "name": "Danger (compatibility)" },
                { "slug": "corex-danger", "color": "#C1352B", "name": "CoreX danger (compatibility)" },
                { "slug": "corex-info", "color": "#1F6FEB", "name": "CoreX info (compatibility)" },
                { "slug": "corex-primary", "color": "#0B1F3B", "name": "CoreX primary (compatibility)" },
                { "slug": "corex-success", "color": "#1A7F4B", "name": "CoreX success (compatibility)" },
                { "slug": "corex-warning", "color": "#875400", "name": "CoreX warning (compatibility)" },
                { "slug": "white", "color": "#FFFFFF", "name": "White (compatibility)" }
            ]
        },
        "typography": {
            "fluid": { "minViewportWidth": "375px", "maxViewportWidth": "1200px" },
            "fontFamilies": [
                {
                    "slug": "heading",
                    "name": "Heading",
                    "fontFamily": "'Space Grotesk', system-ui, sans-serif",
                    "fontFace": [
                        {
                            "fontFamily": "Space Grotesk",
                            "fontStyle": "normal",
                            "fontWeight": "500 700",
                            "fontDisplay": "swap",
                            "src": ["file:./assets/fonts/space-grotesk-latin-500-700.woff2"]
                        }
                    ]
                },
                {
                    "slug": "arabic",
                    "name": "Arabic",
                    "fontFamily": "'IBM Plex Sans Arabic', system-ui, sans-serif",
                    "fontFace": [
                        {
                            "fontFamily": "IBM Plex Sans Arabic",
                            "fontStyle": "normal",
                            "fontWeight": "400",
                            "fontDisplay": "swap",
                            "unicodeRange": "U+0600-06FF, U+0750-077F, U+0870-08FF, U+FB50-FDFF, U+FE70-FEFF",
                            "src": ["file:./assets/fonts/ibm-plex-sans-arabic-400.woff2"]
                        },
                        {
                            "fontFamily": "IBM Plex Sans Arabic",
                            "fontStyle": "normal",
                            "fontWeight": "600",
                            "fontDisplay": "swap",
                            "unicodeRange": "U+0600-06FF, U+0750-077F, U+0870-08FF, U+FB50-FDFF, U+FE70-FEFF",
                            "src": ["file:./assets/fonts/ibm-plex-sans-arabic-600.woff2"]
                        }
                    ]
                },
                {
                    "slug": "body",
                    "name": "Body",
                    "fontFamily": "system-ui, sans-serif"
                },
                {
                    "slug": "mono",
                    "name": "Technical",
                    "fontFamily": "'JetBrains Mono', ui-monospace, 'Cascadia Code', monospace",
                    "fontFace": [
                        {
                            "fontFamily": "JetBrains Mono",
                            "fontStyle": "normal",
                            "fontWeight": "400 600",
                            "fontDisplay": "swap",
                            "src": ["file:./assets/fonts/jetbrains-mono-latin-400-600.woff2"]
                        }
                    ]
                }
            ],
            "defaultFontSizes": false,
            "fontSizes": [
                { "slug": "xs", "size": "0.75rem", "fluid": false, "name": "Caption" },
                { "slug": "sm", "size": "0.875rem", "fluid": false, "name": "Small" },
                { "slug": "base", "size": "1rem", "fluid": false, "name": "Body" },
                { "slug": "lg", "size": "1.375rem", "fluid": { "min": "1.125rem", "max": "1.375rem" }, "name": "Lead" },
                { "slug": "xl", "size": "1.75rem", "fluid": { "min": "1.375rem", "max": "1.75rem" }, "name": "Title" },
                { "slug": "2xl", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.25rem" }, "name": "Heading 3" },
                { "slug": "3xl", "size": "3rem", "fluid": { "min": "2.125rem", "max": "3rem" }, "name": "Heading 2" },
                { "slug": "hero", "size": "4rem", "fluid": { "min": "2.5rem", "max": "4rem" }, "name": "Heading 1" },
                { "slug": "display", "size": "5.5rem", "fluid": { "min": "3rem", "max": "5.5rem" }, "name": "Display" },
                { "slug": "small", "size": "0.875rem", "fluid": false, "name": "Small (compatibility)" },
                { "slug": "medium", "size": "1rem", "fluid": false, "name": "Medium (compatibility)" }
            ]
        },
        "spacing": {
            "units": ["%", "px", "em", "rem", "vw", "vh"],
            "defaultSpacingSizes": false,
            "spacingSizes": [
                { "slug": "10", "size": "0.25rem", "name": "1" },
                { "slug": "20", "size": "0.5rem", "name": "2" },
                { "slug": "25", "size": "0.75rem", "name": "2.5" },
                { "slug": "30", "size": "1rem", "name": "3" },
                { "slug": "40", "size": "1.5rem", "name": "4" },
                { "slug": "50", "size": "2rem", "name": "5" },
                { "slug": "60", "size": "3rem", "name": "6" },
                { "slug": "70", "size": "4rem", "name": "7" },
                { "slug": "80", "size": "6rem", "name": "8" }
            ]
        },
        "shadow": {
            "defaultPresets": false,
            "presets": [
                { "slug": "sm", "name": "Small", "shadow": "0 1px 2px rgba(11, 31, 59, 0.08)" },
                { "slug": "md", "name": "Medium", "shadow": "0 4px 12px rgba(11, 31, 59, 0.10)" },
                { "slug": "lg", "name": "Large", "shadow": "0 12px 32px rgba(11, 31, 59, 0.14)" }
            ]
        },
        "custom": {
            "radius": {
                "xs": "0.1875rem",
                "sm": "0.375rem",
                "md": "0.625rem",
                "lg": "1rem",
                "full": "999px"
            },
            "border": {
                "width": {
                    "thin": "1px",
                    "strong": "4px"
                }
            },
            "motion": {
                "duration": {
                    "instant": "80ms",
                    "fast": "140ms",
                    "base": "200ms",
                    "slow": "320ms"
                },
                "easing": {
                    "standard": "cubic-bezier(0.2, 0, 0, 1)",
                    "emphasized": "cubic-bezier(0.3, 0, 0, 1)"
                }
            },
            "tracking": {
                "tightest": "-0.035em",
                "tighter": "-0.03em",
                "tight": "-0.025em",
                "snug": "-0.02em",
                "close": "-0.015em",
                "slight": "-0.01em"
            },
            "focus": {
                "width": "2px",
                "color": "var(--wp--preset--color--accent)",
                "offset": "2px"
            },
            "z": {
                "base": "0",
                "dropdown": "1000",
                "sticky": "1100",
                "overlay": "1200",
                "modal": "1300",
                "toast": "1400"
            },
            "header": {
                "height": "4rem",
                "heightCompact": "3.25rem"
            },
            "nav": {
                "breakpoint": "782px"
            }
        }
    },
    "styles": {
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--body)",
            "lineHeight": "1.6"
        },
        "color": {
            "background": "var(--wp--preset--color--surface)",
            "text": "var(--wp--preset--color--ink)"
        },
        "spacing": {
            "blockGap": "var(--wp--preset--spacing--40)",
            "padding": {
                "left": "var(--wp--preset--spacing--40)",
                "right": "var(--wp--preset--spacing--40)"
            }
        },
        "elements": {
            "heading": {
                "color": { "text": "var(--wp--preset--color--primary)" },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--heading)",
                    "fontWeight": "600",
                    "lineHeight": "1.2"
                }
            },
            "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--hero)", "lineHeight": "1.05", "letterSpacing": "var(--wp--custom--tracking--tighter)" } },
            "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--3-xl)", "lineHeight": "1.15", "letterSpacing": "var(--wp--custom--tracking--tight)" } },
            "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--2-xl)", "lineHeight": "1.2", "letterSpacing": "var(--wp--custom--tracking--snug)" } },
            "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--xl)", "lineHeight": "1.3", "letterSpacing": "var(--wp--custom--tracking--close)" } },
            "h5": { "typography": { "fontSize": "var(--wp--preset--font-size--lg)", "lineHeight": "1.4", "letterSpacing": "var(--wp--custom--tracking--slight)" } },
            "h6": { "typography": { "fontSize": "var(--wp--preset--font-size--base)", "lineHeight": "1.5", "letterSpacing": "var(--wp--custom--tracking--slight)" } },
            "link": {
                "color": { "text": "var(--wp--preset--color--accent-dark)" },
                ":hover": { "color": { "text": "var(--wp--preset--color--primary)" } }
            },
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--primary)",
                    "text": "var(--wp--preset--color--inverse)"
                },
                "border": { "radius": "var(--wp--custom--radius--sm)" },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--heading)",
                    "fontWeight": "600"
                },
                "spacing": {
                    "padding": {
                        "top": "var(--wp--preset--spacing--30)",
                        "bottom": "var(--wp--preset--spacing--30)",
                        "left": "var(--wp--preset--spacing--50)",
                        "right": "var(--wp--preset--spacing--50)"
                    }
                },
                ":hover": {
                    "color": { "background": "var(--wp--preset--color--primary-dark)" }
                }
            }
        },
        "blocks": {
            "core/navigation": {
                "typography": { "fontFamily": "var(--wp--preset--font-family--heading)" }
            }
        },
        "css": ":where(label, legend){font-family:var(--wp--preset--font-family--heading);}:where(.wp-element-button, .wp-block-button__link){transition:background-color var(--wp--custom--motion--duration--fast) var(--wp--custom--motion--easing--standard), color var(--wp--custom--motion--duration--fast) var(--wp--custom--motion--easing--standard);}@media (prefers-reduced-motion: reduce){:where(.wp-element-button, .wp-block-button__link){transition:none;}}:root:is(:lang(ar), :lang(fa), :lang(ur), :lang(ps), :lang(ckb), :lang(ug)) body{font-family:var(--wp--preset--font-family--arabic);line-height:1.8;}:root:is(:lang(ar), :lang(fa), :lang(ur), :lang(ps), :lang(ckb), :lang(ug)) :is(h1, h2, h3, h4, h5, h6, .wp-block-heading, .wp-block-post-title, .wp-block-site-title, label, legend, .wp-element-button, .wp-block-button__link, .wp-block-navigation){font-family:var(--wp--preset--font-family--arabic);}:root:is(:lang(ar), :lang(fa), :lang(ur), :lang(ps), :lang(ckb), :lang(ug)) :is(h1, h2, h3, h4, h5, h6, .wp-block-heading, .wp-block-post-title){line-height:1.3;letter-spacing:0;}"
    },
    "templateParts": [
        { "name": "header", "title": "Header", "area": "header" },
        { "name": "footer", "title": "Footer", "area": "footer" }
    ],
    "customTemplates": [
        { "name": "page-landing", "title": "Landing page", "postTypes": ["page"] },
        { "name": "page-contact", "title": "Contact page", "postTypes": ["page"] },
        { "name": "page-form", "title": "Form page", "postTypes": ["page"] },
        { "name": "page-about", "title": "About page", "postTypes": ["page"] },
        { "name": "page-services", "title": "Services page", "postTypes": ["page"] },
        { "name": "page-account", "title": "Account page", "postTypes": ["page"] }
    ]
}
