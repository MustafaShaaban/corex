msgstr "يُسجَّل التغيير في سجل الوضع مقرونًا باسمك."

#: plugins/corex-config/src/Operations/ModeDisclosure.php
msgid "Apart from public submissions, the REST API, AJAX, cron, and wp-admin are never intercepted."
