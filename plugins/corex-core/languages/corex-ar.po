msgid "Corex Copyright"
msgstr "حقوق النشر Corex"

#: addons/corex-ui/src/Blocks/copyright/block.json
msgctxt "block description"
msgid "Footer copyright line — current year + site name (dynamic)."
msgstr "سطر حقوق النشر في التذييل: السنة الحالية مع اسم الموقع (ديناميكي)."

#: addons/corex-ui/src/Blocks/cta/block.json
msgctxt "block title"
msgid "Corex Call to Action"
msgstr "دعوة إلى اتخاذ إجراء Corex"

#: addons/corex-ui/src/Blocks/cta/block.json
msgctxt "block description"
msgid "A call-to-action banner — heading, supporting line, and a button (dynamic, edited inline)."
msgstr "شريط دعوة إلى اتخاذ إجراء: عنوان وسطر داعم وزر (ديناميكي، يُحرَّر في مكانه)."

#: addons/corex-ui/src/Blocks/drawer/block.json
msgctxt "block title"
msgid "Corex Drawer"
msgstr "لوحة جانبية Corex"

#: addons/corex-ui/src/Blocks/drawer/block.json
msgctxt "block description"
msgid "An accessible slide-in panel opened by a trigger button — native <dialog>, focus-trapped, ESC and backdrop to close, slides from the start or end edge, degrades without JS (dynamic)."
msgstr "لوحة جانبية منزلقة سهلة الوصول يفتحها زر: عنصر <dialog> أصلي، مع حصر التركيز داخلها، والإغلاق بمفتاح ESC أو بالنقر على الخلفية، وتنزلق من حافة البداية أو النهاية، وتبقى قابلة للاستخدام دون JS (ديناميكي)."

#: addons/corex-ui/src/Blocks/gallery/block.json
msgctxt "block title"
msgid "Corex Gallery"
msgstr "معرض صور Corex"

#: addons/corex-ui/src/Blocks/gallery/block.json
msgctxt "block description"
msgid "A responsive image gallery from the media library, with alt text and optional captions (dynamic)."
msgstr "معرض صور متجاوب من مكتبة الوسائط، مع نص بديل وتسميات توضيحية اختيارية (ديناميكي)."

#: addons/corex-ui/src/Blocks/hero/block.json
msgctxt "block title"
msgid "Corex Hero"
msgstr "قسم الواجهة Corex"

#: addons/corex-ui/src/Blocks/hero/block.json
msgctxt "block description"
msgid "A page hero — eyebrow, heading, subheadline, a button, and an optional background image (dynamic, edited inline)."
msgstr "قسم واجهة للصفحة: عنوان تمهيدي وعنوان رئيسي وعنوان فرعي وزر وصورة خلفية اختيارية (ديناميكي، يُحرَّر في مكانه)."

#: addons/corex-ui/src/Blocks/modal/block.json
msgctxt "block title"
msgid "Corex Modal"
msgstr "نافذة منبثقة Corex"

#: addons/corex-ui/src/Blocks/modal/block.json
msgctxt "block description"
msgid "An accessible dialog opened by a trigger button — native <dialog>, focus-trapped, ESC and backdrop to close, degrades without JS (dynamic)."
msgstr "نافذة حوار سهلة الوصول يفتحها زر: عنصر <dialog> أصلي، مع حصر التركيز داخلها، والإغلاق بمفتاح ESC أو بالنقر على الخلفية، وتبقى قابلة للاستخدام دون JS (ديناميكي)."

#: addons/corex-ui/src/Blocks/posts/block.json
msgctxt "block title"
msgid "Corex Posts"
msgstr "مقالات Corex"

#: addons/corex-ui/src/Blocks/posts/block.json
msgctxt "block description"
msgid "A list of recent posts as accessible cards (dynamic, bounded)."
msgstr "قائمة بأحدث المقالات في شكل بطاقات سهلة الوصول (ديناميكي، محدود العدد)."

#: addons/corex-ui/src/Blocks/pricing/block.json
msgctxt "block title"
msgid "Corex Pricing"
msgstr "الأسعار Corex"

#: addons/corex-ui/src/Blocks/pricing/block.json
msgctxt "block description"
msgid "A pricing card — plan, price, features, and an optional CTA (dynamic)."
msgstr "بطاقة تسعير: الخطة والسعر والميزات وزر دعوة إلى إجراء اختياري (ديناميكي)."

#: addons/corex-ui/src/Blocks/stat/block.json
msgctxt "block title"
msgid "Corex Stat"
msgstr "إحصائية Corex"

#: addons/corex-ui/src/Blocks/stat/block.json
msgctxt "block description"
msgid "A single statistic — a value, a label, and an optional description (dynamic)."
msgstr "إحصائية واحدة: قيمة وتسمية ووصف اختياري (ديناميكي)."

#: addons/corex-ui/src/Blocks/tabs/block.json
msgctxt "block title"
msgid "Corex Tabs"
msgstr "علامات تبويب Corex"

#: addons/corex-ui/src/Blocks/tabs/block.json
msgctxt "block description"
msgid "Tabbed content with no front-end JavaScript — a CSS-only accessible tabs pattern (dynamic, edited inline)."
msgstr "محتوى بعلامات تبويب دون JavaScript في الواجهة الأمامية، بنمط علامات تبويب سهل الوصول يعتمد على CSS فقط (ديناميكي، يُحرَّر في مكانه)."

#: addons/corex-ui/src/Blocks/team/block.json
msgctxt "block title"
msgid "Corex Team"
msgstr "الفريق Corex"

#: addons/corex-ui/src/Blocks/team/block.json
msgctxt "block description"
msgid "A responsive grid of team members — photo, name, role, and bio (dynamic, edited inline)."
msgstr "شبكة متجاوبة لأعضاء الفريق: الصورة والاسم والدور والنبذة (ديناميكي، يُحرَّر في مكانه)."

#: addons/corex-ui/src/Blocks/testimonial/block.json
msgctxt "block title"
msgid "Corex Testimonial"
msgstr "شهادة Corex"

#: addons/corex-ui/src/Blocks/testimonial/block.json
msgctxt "block description"
msgid "A testimonial quote with attribution (dynamic, accessible figure)."
msgstr "اقتباس شهادة مع نسبتها إلى صاحبها (ديناميكي، عنصر figure سهل الوصول)."

#: plugins/corex-blocks/src/blocks/entity-field/block.json
msgctxt "block title"
msgid "Entity Field"
msgstr "حقل الكيان"

#: plugins/corex-blocks/src/blocks/entity-field/block.json
msgctxt "block description"
msgid "Displays a Corex entity field (dynamic, server-rendered)."
msgstr "يعرض حقل كيان من Corex (ديناميكي، يُعرض من الخادم)."

#: plugins/corex-blocks/src/blocks/newsletter-signup/block.json
msgctxt "block title"
msgid "Newsletter Signup"
msgstr "الاشتراك في النشرة البريدية"

#: plugins/corex-blocks/src/blocks/newsletter-signup/block.json
msgctxt "block description"
msgid "A double opt-in newsletter signup form (dynamic, server-rendered; wired to the real subscribe endpoint)."
msgstr "نموذج اشتراك في النشرة البريدية بتأكيد مزدوج (ديناميكي، يُعرض من الخادم؛ موصول بنقطة الاشتراك الفعلية)."

#: plugins/corex-blocks/src/blocks/social-share/block.json
msgctxt "block title"
msgid "Social Share"
msgstr "المشاركة الاجتماعية"

#: plugins/corex-blocks/src/blocks/social-share/block.json
msgctxt "block description"
msgid "A privacy-friendly share bar for the current post (dynamic, server-rendered; no tracking, no counts)."
msgstr "شريط مشاركة يحترم الخصوصية للمقالة الحالية (ديناميكي، يُعرض من الخادم؛ دون تتبّع ودون عدّادات)."

#: plugins/corex-forms/src/Block/blocks/corex-flow/block.json
msgctxt "block title"
msgid "Flow"
msgstr "مسار"

#: plugins/corex-forms/src/Block/blocks/corex-flow/block.json
msgctxt "block description"
msgid "Renders a published Corex flow."
msgstr "يعرض مسار Corex منشورًا."

#: plugins/corex-forms/src/Block/blocks/corex-form/block.json
msgctxt "block title"
msgid "Corex Form"
msgstr "نموذج Corex"

#: plugins/corex-forms/src/Block/blocks/corex-form/block.json
msgctxt "block description"
msgid "Renders a registered Corex form (server-rendered, secured submit)."
msgstr "يعرض نموذج Corex مسجّلًا (يُعرض من الخادم، مع إرسال آمن)."

#: plugins/corex-forms/src/Block/blocks/cta-flow/block.json
msgctxt "block title"
msgid "CTA + Flow"
msgstr "دعوة إلى إجراء + مسار"

#: plugins/corex-forms/src/Block/blocks/cta-flow/block.json
msgctxt "block description"
msgid "Pairs call-to-action content with a published Corex flow."
msgstr "يجمع محتوى الدعوة إلى اتخاذ إجراء مع مسار Corex منشور."

#: plugins/corex-forms/src/Block/blocks/subscribe/block.json
msgctxt "block title"
msgid "Subscribe"
msgstr "الاشتراك"

#: plugins/corex-forms/src/Block/blocks/subscribe/block.json
msgctxt "block description"
msgid "Renders a published Corex flow as a subscription form."
msgstr "يعرض مسار Corex منشورًا في صورة نموذج اشتراك."

#: plugins/corex-forms/src/Block/blocks/success-message/block.json
msgctxt "block title"
msgid "Success Message"
msgstr "رسالة النجاح"

#: plugins/corex-forms/src/Block/blocks/success-message/block.json
msgctxt "block description"
msgid "Renders the success message from a published Corex flow."
msgstr "يعرض رسالة النجاح من مسار Corex منشور."

#: plugins/corex-forms/src/Block/blocks/survey/block.json
msgctxt "block title"
msgid "Survey"
msgstr "استبيان"

#: plugins/corex-forms/src/Block/blocks/survey/block.json
msgctxt "block description"
msgid "Renders a published Corex flow as a survey."
msgstr "يعرض مسار Corex منشورًا في صورة استبيان."

