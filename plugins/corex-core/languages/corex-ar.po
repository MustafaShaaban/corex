msgid "File editing disabled"
msgstr "تحرير الملفات معطّل"

#: plugins/corex-config/src/Security/HardeningChecks.php
msgid "The theme/plugin file editor is disabled in wp-admin."
msgstr "محرر ملفات القوالب والإضافات معطّل في wp-admin."

#: plugins/corex-config/src/Security/HardeningChecks.php
msgid "Set DISALLOW_FILE_EDIT to true in wp-config.php to disable the in-admin code editor."
msgstr "اضبط DISALLOW_FILE_EDIT على true في wp-config.php لتعطيل محرر الشيفرة داخل لوحة الإدارة."

#: plugins/corex-config/src/Security/HardeningChecks.php
msgid "PHP errors are not displayed to visitors."
msgstr "أخطاء PHP لا تُعرض للزوار."

#: plugins/corex-config/src/Security/HardeningChecks.php
msgid "Set WP_DEBUG_DISPLAY to false so errors are logged, not shown to visitors."
msgstr "اضبط WP_DEBUG_DISPLAY على false لتُسجَّل الأخطاء بدلًا من عرضها للزوار."

#: plugins/corex-config/src/Security/HardeningChecks.php
msgid "No default \"admin\" account"
msgstr "لا يوجد حساب \"admin\" افتراضي"

#: plugins/corex-config/src/Security/HardeningChecks.php
msgid "There is no user literally named \"admin\"."
msgstr "لا يوجد مستخدم اسمه \"admin\" حرفيًا."

#: plugins/corex-config/src/Security/HardeningChecks.php
msgid "Avoid a user named \"admin\" — it is the first username brute-force bots try."
msgstr "تجنّب وجود مستخدم باسم \"admin\" — فهو أول اسم مستخدم تجرّبه روبوتات هجمات التخمين."

#: plugins/corex-config/src/Security/HardeningChecks.php
msgid "Search indexing allowed"
msgstr "الفهرسة في محركات البحث مسموحة"

#: plugins/corex-config/src/Security/HardeningChecks.php
msgid "Search engines are not discouraged from indexing this production site."
msgstr "لا تُطالَب محركات البحث بعدم فهرسة موقع الإنتاج هذا."

#: plugins/corex-config/src/Security/HardeningChecks.php
msgid "Review Settings → Reading → Search Engine Visibility before Production launch."
msgstr "راجع الإعدادات ← القراءة ← الظهور لمحركات البحث قبل الإطلاق في الإنتاج."

#: plugins/corex-config/src/Security/HardeningChecks.php
msgid "Authentication salts configured"
msgstr "تم إعداد مفاتيح المصادقة وقيم salt"

#: plugins/corex-config/src/Security/HardeningChecks.php
