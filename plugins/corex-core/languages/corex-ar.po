#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
msgid "Browsers keep copies of CSS, JavaScript and images so pages load faster."
msgstr "تحتفظ المتصفحات بنسخ من ملفات CSS وJavaScript والصور لتُحمَّل الصفحات أسرع."

#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
msgid "The visitor’s browser"
msgstr "متصفح الزائر"

#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
msgid "No website can empty a visitor’s browser cache. CoreX changes the version on each asset when it changes, which is what makes browsers fetch the new file instead of reusing the old one."
msgstr "لا يستطيع أي موقع إفراغ ذاكرة التخزين المؤقت في متصفح الزائر. يغيّر CoreX النسخة على كل ملف من ملفات الأصول عند تغيّره، وهذا ما يجعل المتصفحات تجلب الملف الجديد بدلًا من إعادة استخدام القديم."

#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
msgid "PHP OPcache"
msgstr "PHP OPcache"

#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
msgid "PHP keeps compiled code in memory so it is not recompiled on every request."
msgstr "يحتفظ PHP بالشيفرة المترجمة في الذاكرة حتى لا يعيد ترجمتها مع كل طلب."

#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
msgid "This host does not allow CoreX to inspect OPcache, so its state cannot be reported. That is a hosting setting, not a fault."
msgstr "لا تسمح هذه الاستضافة لـ CoreX بفحص OPcache، لذا لا يمكن عرض حالته. هذا إعداد من الاستضافة، وليس عطلًا."

#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
msgid "OPcache did not report a status. It may be disabled, or restricted on this host."
msgstr "لم يُبلغ OPcache عن أي حالة. ربما يكون معطّلًا، أو مقيّدًا في هذه الاستضافة."

#. translators: %s: percentage of OPcache lookups that were hits.
#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
#, php-format
msgid "Serving %s%% of lookups from memory. Reset belongs to your deployment process, not to this screen."
msgstr "يُخدَم %s%% من عمليات البحث من الذاكرة. إعادة التعيين من مهام عملية النشر لديك، لا من مهام هذه الشاشة."

#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
msgid "Reset belongs to your deployment process, not to this screen."
msgstr "إعادة التعيين من مهام عملية النشر لديك، لا من مهام هذه الشاشة."

#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
msgid "This request’s cache"
msgstr "ذاكرة التخزين المؤقت لهذا الطلب"

#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
msgid "WordPress remembers values within a single page load so the same query is not run twice."
msgstr "يتذكر WordPress القيم خلال تحميل صفحة واحدة حتى لا يُنفَّذ الاستعلام نفسه مرتين."

#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
msgid "Always present, and gone when the request ends. Clearing it affects nothing beyond the current page load."
msgstr "موجودة دائمًا، وتزول عند انتهاء الطلب. لا يؤثر مسحها في أي شيء خارج تحميل الصفحة الحالي."

#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
#: plugins/corex-core/src/Cache/WordPressCacheStore.php
msgid "Persistent object cache"
msgstr "ذاكرة التخزين المؤقت الدائمة للكائنات"

#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
msgid "Keeps database results in memory between requests, which is the single biggest speed gain on a busy site."
msgstr "تحتفظ بنتائج قاعدة البيانات في الذاكرة بين الطلبات، وهذا أكبر مكسب منفرد في السرعة على موقع مزدحم."

#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
msgid "Object cache drop-in"
msgstr "ملف drop-in لذاكرة التخزين المؤقت للكائنات"

#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
msgid "WordPress keeps transients here as well, so flushing this would also remove CoreX rate limits and spent-token records. CoreX will not do that; run `wp cache flush` yourself if you intend it."
msgstr "يحفظ WordPress البيانات المؤقتة (transients) هنا أيضًا، لذا فإن تفريغها سيزيل أيضًا حدود معدل الطلبات في CoreX وسجلات الرموز المستهلكة. لن يفعل CoreX ذلك؛ شغّل `wp cache flush` بنفسك إن كنت تقصده."

#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
msgid "Drop-in present but not in use"
msgstr "ملف drop-in موجود لكنه غير مستخدم"

#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
msgid "An object-cache drop-in is installed but WordPress is not using it. A cache that is present is not a cache that is running."
msgstr "ملف drop-in لذاكرة التخزين المؤقت للكائنات مثبّت، لكن WordPress لا يستخدمه. وجود ذاكرة تخزين مؤقت لا يعني أنها تعمل."

#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
msgid "Not installed, and not required. CoreX works fully without one — this is the normal setup on shared hosting."
msgstr "غير مثبّتة، وليست مطلوبة. يعمل CoreX بالكامل من دونها، وهذا هو الإعداد المعتاد في الاستضافة المشتركة."

#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
msgid "CoreX application cache"
msgstr "ذاكرة التخزين المؤقت لتطبيق CoreX"

#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
msgid "CoreX’s own cached values — build metadata and counts it would otherwise recompute."
msgstr "القيم التي يخزّنها CoreX مؤقتًا بنفسه: البيانات الوصفية للبناء والأعداد التي كان سيعيد حسابها لولا ذلك."

#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
msgid "Safe to clear at any time. Everything here is rebuilt on the next request, and CoreX’s rate limits and pending confirmations are deliberately excluded."
msgstr "يمكن مسحها بأمان في أي وقت. يُعاد بناء كل ما هنا عند الطلب التالي، وتُستثنى عمدًا حدود معدل الطلبات والتأكيدات المعلّقة في CoreX."

#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
msgid "Serves whole pages without running WordPress, for visitors who are not signed in."
msgstr "تقدّم صفحات كاملة دون تشغيل WordPress، للزوار الذين لم يسجّلوا الدخول."

#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
msgid "Purging is handled by the provider that registered itself."
msgstr "يتولى التفريغَ المزوّدُ الذي سجّل نفسه."

#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
msgid "No page cache detected. CoreX does not provide one — it integrates with whichever you choose."
msgstr "لم تُكتشف ذاكرة تخزين مؤقت للصفحات. لا يوفر CoreX واحدة، بل يتكامل مع أيّ منها تختاره."

#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
msgid "CDN"
msgstr "CDN"

#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
msgid "Serves assets from servers near your visitors."
msgstr "تقدّم ملفات الأصول من خوادم قريبة من زوارك."

#: plugins/corex-core/src/Cache/Status/CacheStatusReport.php
